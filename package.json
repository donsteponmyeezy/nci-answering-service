  },
  "dependencies": {
    "next": "14.2.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "14.2.30",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "^5"
  }
}
