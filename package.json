{
  "name": "nci-answering-service",
  "version": "1.0.0",
  "private": true,
  "description": "Next Call In (NCI) website \u2014 Next.js App Router with retained v1 and v2 HTML references.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
