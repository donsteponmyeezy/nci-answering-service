# Lead delivery (required in production — /api/lead fails loudly without these)
RESEND_API_KEY=
LEAD_TO_EMAIL=info@nciansweringservice.net
LEAD_FROM_EMAIL="NCI Website <leads@nciansweringservice.com>"

# Cloudflare Turnstile (optional; when TURNSTILE_SECRET_KEY is unset, the honeypot + timing check still run)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Tag Manager container (optional; nothing loads when unset)
NEXT_PUBLIC_GTM_ID=

# Canonical origin used for metadata, sitemap, and schema
NEXT_PUBLIC_SITE_URL=https://nciansweringservice.com
